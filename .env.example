# Razorpay Test Mode Credentials (MUST start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Database Configuration
DATABASE_URL=sqlite:///recoup.db

# Application & Environment
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Recovery & Policy Guardrails
MAX_GLOBAL_BUDGET_INR=50000.0
DND_START_HOUR=21
DND_END_HOUR=9
DEFAULT_HOLDOUT_PERCENT=15.0
SPLIT_SEED=42

# Policy Engine (Phase 5) - see README.md "Regulatory constraints (Phase 5)"
RBI_EMANDATE_PRE_DEBIT_NOTICE_HOURS=24.0
NPCI_UPI_AUTOPAY_MAX_ATTEMPTS=4
DEFAULT_COOLDOWN_HOURS=6.0

# Optional LLM API Key (Fallback diagnosis uses deterministic mock if not set)
GEMINI_API_KEY=
