# Base URL of the recoup API (core/ingest/webhook_app.py, mounted with
# core/api's read-only dashboard routes). Run it locally with:
#   recoup serve --port 8000
# Vite only exposes env vars prefixed VITE_ to client code - see
# https://vite.dev/guide/env-and-mode.html. Copy this file to `.env.local`
# (git-ignored) and adjust if the API runs on a different host/port.
VITE_API_BASE_URL=http://127.0.0.1:8000
